{
  "DSU": {
    "prefix": "DSU",
    "body": [
      "struct DSU {",
        "struct Node {",
          "int p, sz;",
          "void merge(Node &o) {",
            "o.p = p;",
            "sz += o.sz;",
          "}",
        "};",
        "vector<Node> P;",
        "DSU(int N) {",
          "build(N);",
        "}",
        "void build(int N) {",
          "for (int i = 0; i < N; ++i) P.push_back({i, 1});",
        "}",
        "int _find(int c) {",
          "return c == P[c].p? c : P[c].p = _find(P[c].p);",
        "}",
        "Node& find(int c) {",
          "return P[_find(c)];",
        "}",
        "void merge(int a, int b) {",
          "find(a).merge(find(b));",
        "}",
      "};"
    ],
    "description": "Perfect DSU template by Dudu Lai"
  }
}
